{
  programs.niri.settings.input = {
    focus-follows-mouse = {
      enable = true;
      max-scroll-amount = "90%";
    };

    keyboard = {
      numlock = true;
      track-layout = "window";
    };

    mod-key = "Super";
    mod-key-nested = "Alt";

    warp-mouse-to-focus = {
      enable = true;
      mode = "center-xy";
    };
  };
}
